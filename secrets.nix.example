# ============================================
#  SSH KEYS - DO NOT COMMIT THIS FILE
# ============================================
#
#  1. Copy this file:  cp secrets.nix.example secrets.nix
#  2. Find your key:   cat ~/.ssh/authorized_keys
#  3. Paste it below between the quotes
#
#  This file is in .gitignore and won't be pushed to GitHub.
#

{
  sshKeys = [
    # Paste your SSH public key here (the whole line starting with ssh-ed25519 or ssh-rsa)
    "ssh-ed25519 AAAA... your-key-here"
  ];
}
